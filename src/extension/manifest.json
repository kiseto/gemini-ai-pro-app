{
	"manifest_version": 3,
	"name": "Google AI Pro Portal",
	"version": "1.0.0",
	"description": "Smart subscription & promo offer injector for Google One AI Premium with checkout safety guard.",
	"permissions": ["storage"],
	"host_permissions": [
		"https://one.google.com/*",
		"https://tokenized.play.google.com/*",
		"https://play.google.com/*"
	],
	"action": {
		"default_popup": "src/extension/popup.html",
		"default_title": "Google AI Pro Portal"
	},
	"icons": {
		"16": "icons/16.png",
		"32": "icons/32.png",
		"48": "icons/48.png",
		"128": "icons/128.png",
		"192": "icons/192.png"
	},
	"content_scripts": [
		{
			"matches": ["https://one.google.com/*"],
			"js": ["src/extension/content.ts"],
			"run_at": "document_start",
			"all_frames": false
		},
		{
			"matches": ["https://one.google.com/*"],
			"js": ["src/extension/inject.ts"],
			"run_at": "document_start",
			"world": "MAIN",
			"all_frames": false
		},
		{
			"matches": ["https://tokenized.play.google.com/*"],
			"js": ["src/extension/play-guard.ts"],
			"run_at": "document_idle",
			"world": "MAIN",
			"all_frames": true
		}
	]
}
