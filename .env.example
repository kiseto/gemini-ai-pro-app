# ==============================================================================
# Gemini AI Pro Portal - Environment Configuration Template
# ==============================================================================
# This file serves as documentation for the environment variables used by both
# the landing page and the browser extension build.
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Public Application Metadata
VITE_APP_NAME="Gemini AI Pro Portal"
VITE_APP_SHORT_NAME="AI Pro Portal"
VITE_APP_URL="https://gemini-ai-pro.pages.dev"
VITE_APP_VERSION="1.0.0"

# Promotional Offer Tokens (Base64 Encoded Payloads)
# Replace these with your actual promotional offer tokens in your private .env file.
# Note: Keep your .env file private and never commit it to source control.
VITE_OFFER_TOKEN_12M="your_tier_1_12m_offer_token_here"
VITE_OFFER_TOKEN_6M_SS="your_tier_2_6m_ss_offer_token_here"
VITE_OFFER_TOKEN_6M="your_tier_3_6m_offer_token_here"
VITE_OFFER_TOKEN_6M_2="your_tier_4_6m_backup_offer_token_here"
VITE_OFFER_TOKEN_YT_PREMIUM="your_youtube_premium_addon_token_here"

